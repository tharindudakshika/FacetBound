{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "emerald", "name": "Emerald", "color": "#0f2e23" },
        { "slug": "emerald-deep", "name": "Emerald Deep", "color": "#081f19" },
        { "slug": "emerald-darkest", "name": "Emerald Darkest", "color": "#051a14" },
        { "slug": "emerald-mid", "name": "Emerald Mid", "color": "#152f26" },
        { "slug": "emerald-light", "name": "Emerald Light", "color": "#1a4a3a" },
        { "slug": "terracotta", "name": "Terracotta", "color": "#c88a75" },
        { "slug": "terracotta-hover", "name": "Terracotta Hover", "color": "#a66b57" },
        { "slug": "cream", "name": "Cream", "color": "#fdfbf7" },
        { "slug": "cream-warm", "name": "Cream Warm", "color": "#f3f1eb" },
        { "slug": "cream-border", "name": "Cream Border", "color": "#edeae2" },
        { "slug": "ink", "name": "Ink", "color": "#142720" },
        { "slug": "ink-soft", "name": "Ink Soft", "color": "#22342c" },
        { "slug": "slate-text", "name": "Slate Text", "color": "#3a4a44" },
        { "slug": "slate-muted", "name": "Slate Muted", "color": "#7a8b84" },
        { "slug": "slate-border", "name": "Slate Border", "color": "#a9b4c2" },
        { "slug": "slate-light", "name": "Slate Light", "color": "#e7eaee" },
        { "slug": "sterling", "name": "Sterling", "color": "#e2e8f0" }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "slug": "serif",
          "name": "Playfair Display",
          "fontFamily": "'Playfair Display', serif"
        },
        {
          "slug": "sans",
          "name": "Montserrat",
          "fontFamily": "'Montserrat', sans-serif"
        },
        {
          "slug": "body",
          "name": "Lato",
          "fontFamily": "'Lato', sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "13px" },
        { "slug": "medium", "name": "Medium", "size": "16px" },
        { "slug": "large", "name": "Large", "size": "22px" },
        { "slug": "x-large", "name": "Extra Large", "size": "32px" },
        { "slug": "xx-large", "name": "XX Large", "size": "42px" }
      ]
    },
    "spacing": {
      "customSpacingSize": true,
      "units": ["px", "%", "em", "rem", "vw", "vh"],
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "8px" },
        { "slug": "30", "name": "S", "size": "16px" },
        { "slug": "40", "name": "M", "size": "24px" },
        { "slug": "50", "name": "L", "size": "48px" },
        { "slug": "60", "name": "XL", "size": "80px" }
      ]
    },
    "custom": {
      "sectionPaddingInline": "clamp(20px, 4vw, 48px)"
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--cream)",
      "text": "var(--wp--preset--color--ink)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "16px",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--terracotta)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--terracotta-hover)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontWeight": "600"
        },
        "color": {
          "text": "var(--wp--preset--color--emerald)"
        }
      },
      "button": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "14px",
          "fontWeight": "600",
          "letterSpacing": "0.3px"
        },
        "color": {
          "text": "var(--wp--preset--color--cream)",
          "background": "var(--wp--preset--color--terracotta)"
        },
        "border": {
          "radius": "10px"
        },
        "spacing": {
          "padding": {
            "top": "16px",
            "bottom": "16px",
            "left": "34px",
            "right": "34px"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--terracotta-hover)"
          }
        }
      }
    },
    "spacing": {
      "padding": {
        "left": "var(--wp--custom--section-padding-inline)",
        "right": "var(--wp--custom--section-padding-inline)"
      }
    },
    "blocks": {
      "core/post-title": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": []
}
